{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flavorplus/onboardd/config/schema.json",
  "title": "onboardd configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "device_name": { "type": "string", "minLength": 1 }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logo": { "type": "string", "minLength": 1 },
        "primary_color": { "$ref": "#/$defs/color" },
        "background_color": { "$ref": "#/$defs/color" },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "subtitle": { "type": "string" }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface": { "type": "string", "minLength": 1 },
        "requirement": {
          "type": "string",
          "enum": ["local", "internet"]
        },
        "infrastructure_enabled": { "type": "boolean" },
        "standalone_enabled": { "type": "boolean" },
        "provisioning": { "$ref": "#/$defs/provisioning" },
        "standalone": { "$ref": "#/$defs/standalone" }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listener_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "not": { "const": 80 }
        }
      }
    }
  },
  "$defs": {
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ssid": { "type": "string", "minLength": 1 },
        "password_file": { "type": "string", "minLength": 1 }
      }
    },
    "standalone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ssid": { "type": "string", "minLength": 1 },
        "password_file": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
