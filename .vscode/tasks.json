{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Go: build onboardd",
      "type": "process",
      "command": "go",
      "args": ["build", "-o", "${workspaceFolder}/bin/onboardd", "./cmd/onboardd"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["Frontend: build"],
      "problemMatcher": "$go"
    },
    {
      "label": "Go: test all",
      "type": "process",
      "command": "go",
      "args": ["test", "./..."],
      "group": "test",
      "problemMatcher": "$go"
    },
    {
      "label": "Go: build Pi Zero 2 W",
      "type": "process",
      "command": "go",
      "args": [
        "build",
        "-trimpath",
        "-buildvcs=false",
        "-ldflags=-buildid=",
        "-o",
        "${workspaceFolder}/bin/onboardd-linux-arm64",
        "./cmd/onboardd"
      ],
      "options": {
        "env": {
          "GOOS": "linux",
          "GOARCH": "arm64",
          "CGO_ENABLED": "0"
        }
      },
      "dependsOn": ["Frontend: build"],
      "problemMatcher": "$go"
    },
    {
      "label": "Go: build Linux AMD64",
      "type": "process",
      "command": "go",
      "args": [
        "build",
        "-trimpath",
        "-buildvcs=false",
        "-ldflags=-buildid=",
        "-o",
        "${workspaceFolder}/bin/onboardd-linux-amd64",
        "./cmd/onboardd"
      ],
      "options": {
        "env": {
          "GOOS": "linux",
          "GOARCH": "amd64",
          "CGO_ENABLED": "0"
        }
      },
      "dependsOn": ["Frontend: build"],
      "problemMatcher": "$go"
    },
    {
      "label": "Release: build Linux binaries",
      "type": "process",
      "command": "${workspaceFolder}/scripts/build-release.sh",
      "args": ["${input:releaseVersion}"],
      "dependsOn": ["Frontend: build"],
      "problemMatcher": "$go"
    },
    {
      "label": "Release: build Debian packages",
      "type": "process",
      "command": "${workspaceFolder}/scripts/build-deb.sh",
      "args": ["${input:releaseVersion}"],
      "dependsOn": ["Frontend: build"],
      "problemMatcher": "$go"
    },
    {
      "label": "Go: vet all",
      "type": "process",
      "command": "go",
      "args": ["vet", "./..."],
      "problemMatcher": "$go"
    },
    {
      "label": "Go: format all",
      "type": "process",
      "command": "go",
      "args": ["fmt", "./..."],
      "problemMatcher": []
    },
    {
      "label": "Config: inspect example",
      "type": "process",
      "command": "go",
      "args": [
        "run",
        "./cmd/onboardd",
        "debug",
        "config",
        "--config",
        "config/example.toml",
        "--render",
        "--device-id",
        "DEV00001",
        "--hostname",
        "onboardd-dev"
      ],
      "problemMatcher": "$go"
    },
    {
      "label": "Frontend: install",
      "type": "process",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: dev",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: dev (Wi-Fi only)",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev:network-only"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: dev (standalone only)",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev:standalone-only"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
		{
			"label": "Frontend: dev (branded)",
			"type": "process",
			"command": "npm",
			"args": ["run", "dev:branded"],
			"options": {
				"cwd": "${workspaceFolder}/frontend"
			},
			"isBackground": true,
			"problemMatcher": []
		},
    {
      "label": "Frontend: test",
      "type": "process",
      "command": "npm",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Frontend: build",
      "type": "process",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Scripts: check",
      "type": "process",
      "command": "bash",
      "args": [
        "-n",
        "scripts/setup-recorder.sh",
        "scripts/dbus-trace-recorder.sh",
        "scripts/build-release.sh",
        "scripts/build-deb.sh",
        "scripts/check-deb.sh",
        "packaging/debian/postinst",
        "packaging/debian/prerm",
        "packaging/debian/postrm"
      ],
      "problemMatcher": []
    },
    {
      "label": "Check: all",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Go: format all",
        "Go: test all",
        "Go: vet all",
        "Scripts: check",
        "Frontend: test",
        "Frontend: build",
        "Go: build onboardd",
        "Go: build Pi Zero 2 W",
        "Go: build Linux AMD64"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "releaseVersion",
      "type": "promptString",
      "description": "v-prefixed release version",
      "default": "v0.1.0"
    }
  ]
}
